<Project Sdk="Microsoft.NET.Sdk" ToolsVersion="Current">
  <PropertyGroup>
    <TargetFrameworks>net45;net461;netstandard2.0;netstandard2.1;net8.0;net10.0;net11.0</TargetFrameworks>
    <AssemblyName>XCode</AssemblyName>
    <RootNamespace>XCode</RootNamespace>
    <AssemblyTitle>XCode Super ORM Middleware</AssemblyTitle>
    <Description>High-performance .NET data middleware (super ORM) focused on CRUD and massive data, with multi-level caching, automatic migration, sharding, strongly-typed queries and cross-database migration.</Description>
    <Company>新生命开发团队</Company>
    <Copyright>©2002-2026 NewLife</Copyright>
    <VersionPrefix>12.3</VersionPrefix>
    <VersionSuffix>$([System.DateTime]::Now.ToString(`yyyy.MMdd`))</VersionSuffix>
    <Version>$(VersionPrefix).$(VersionSuffix)</Version>
    <FileVersion>$(Version)</FileVersion>
    <AssemblyVersion>$(VersionPrefix).$([System.DateTime]::Now.ToString(`yyyy.MMdd`))</AssemblyVersion>
    <OutputPath>..\Bin</OutputPath>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>..\Doc\newlife.snk</AssemblyOriginatorKeyFile>
    <NoWarn>1701;1702;NU5104;NETSDK1138;CS7035</NoWarn>
    <AnalysisLevel>latest</AnalysisLevel>
    <WarningsAsErrors>CA2007</WarningsAsErrors>
  </PropertyGroup>
  <!-- net8+ 对齐 NewLife.Core 策略：启用 AOT/裁剪分析器；SDK 会将目标程序集标记为 IsTrimmable -->
  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <PropertyGroup>
    <PackageId>NewLife.XCode</PackageId>
    <PackageDescription>High-performance .NET data middleware (super ORM) focused on CRUD and massive data, with multi-level caching, automatic migration, sharding, strongly-typed queries and cross-database migration. 高性能 .NET 数据中间件（超级ORM），聚焦添删改查与海量数据，内置多级缓存、自动迁移、分表分库、强类型查询与跨库迁移。</PackageDescription>
    <Authors>$(Company)</Authors>
    <PackageProjectUrl>https://newlifex.com/xcode</PackageProjectUrl>
    <PackageIcon>leaf.png</PackageIcon>
    <RepositoryUrl>https://github.com/NewLifeX/X</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>新生命团队;X组件;NewLife;$(AssemblyName)</PackageTags>
    <PackageReleaseNotes>SonnetDB 官方 ADO.NET 驱动适配与 net10.0 依赖包；31 种语言运行时消息与实体元数据本地化；NativeAOT 兼容（net8/net10）与 16 场景冒烟；实体缓存并发刷新修复；SqlServer 批量超时、PostgreSQL/SqlServer 自动建库与属性更新 SQL 改写修复；依赖升级到 NewLife.Core 12.0.2026.1024 等最新正式版；新增导航、树形、ETL、迁移、多结果集测试</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="1.1.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NewLife.Core" Version="12.0.2026.1128-beta0257" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="NewLife" />
  </ItemGroup>
  <ItemGroup>

  </ItemGroup>
  <ItemGroup>

    <Compile Remove="DataAccessLayer\Model\SerializableDataMember.cs" />
    <Compile Remove="DataAccessLayer\MSPageSplit.cs" />
    <Compile Remove="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\Doc\leaf.png" Link="leaf.png" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\README.nuget.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  <!-- XC0001 分析器随主包分发：下游引用 NewLife.XCode 即自动生效，无需额外包 -->
  <ItemGroup>
    <None Include="..\XCode.Analyzers\bin\$(Configuration)\netstandard2.0\XCode.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>
  <!-- 打包前构建分析器。必须经 BeforePack 挂在 _GetPackageFiles/GenerateNuspec 之前：
       直接 BeforeTargets="Pack" 时依赖目标先生效，干净检出（无 bin 目录）下打包会因找不到分析器 DLL 而失败。
       分析器不参与 XCode 编译（net45 无法引用 netstandard2.0），故用独立进程构建；
       在打包进程内用 MSBuild 任务会复用 Restore 阶段的项目求值缓存（缺 nuget.g.targets），导致编译缺少 netstandard 引用。 -->
  <PropertyGroup>
    <BeforePack>BuildAnalyzersForPackage;$(BeforePack)</BeforePack>
  </PropertyGroup>
  <Target Name="BuildAnalyzersForPackage">
    <!-- 路径统一用正斜杠：CI 在 Linux/macOS 执行，Exec 的原样命令行不会做反斜杠归一化 -->
    <Exec Command="dotnet build &quot;$(MSBuildThisFileDirectory)../XCode.Analyzers/XCode.Analyzers.csproj&quot; -c $(Configuration) --nologo" StandardOutputImportance="low" />
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)../XCode.Analyzers/bin/$(Configuration)/netstandard2.0/XCode.Analyzers.dll')" Text="XCode.Analyzers 未生成，无法随包分发 analyzers/dotnet/cs/XCode.Analyzers.dll" />
  </Target>
</Project>
